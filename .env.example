# Copiar para .env. Nenhum diretório ou modelo é criado ao carregar Settings.
SUBTITLE_FFMPEG_PATH=ffmpeg
SUBTITLE_FFPROBE_PATH=ffprobe
SUBTITLE_WORK_DIR=work
SUBTITLE_OUTPUT_DIR=output
SUBTITLE_DATABASE_PATH=work/jobs.sqlite3
SUBTITLE_WHISPER_MODEL=small
SUBTITLE_WHISPER_DEVICE=cpu
SUBTITLE_WHISPER_COMPUTE_TYPE=int8
# OpenCode Go: preencher a chave somente no .env local.
# SUBTITLE_LLM_API_KEY=
SUBTITLE_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
SUBTITLE_LLM_MODEL=minimax-m3.1-flash
SUBTITLE_LLM_TIMEOUT=30
SUBTITLE_MEDIA_TIMEOUT=600
SUBTITLE_MAX_UPLOAD_BYTES=500000000
# Opcional: h264_nvenc, h264_qsv ou h264_amf, somente se testado no equipamento.
SUBTITLE_RENDER_ENCODER=libx264
